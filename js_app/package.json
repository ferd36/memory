{
  "name": "memory-trainer",
  "version": "1.0.0",
  "type": "module",
  "description": "Memory Trainer App",
  "main": "dist-electron/index.js",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "test": "node --test \"test/unit/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 --test-timeout=180000 \"test/integration/*.test.js\"",
    "test:all": "npm run test && npm run test:integration",
    "test:strict": "MEMORY_TRAINER_STRICT=1 node --test --test-concurrency=1 --test-timeout=180000 \"test/**/*.test.js\"",
    "test:watch": "node --test --watch \"test/unit/*.test.js\""
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^29.1.0",
    "vite": "^5.1.4",
    "vite-plugin-electron": "^0.28.3",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
